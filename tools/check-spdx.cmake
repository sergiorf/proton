# SPDX-License-Identifier: AGPL-3.0-only
# Checks that every source file under -DROOT=<dir> starts with the SPDX line, and fails listing
# the files that do not. Run with `cmake -DROOT=<dir> -P check-spdx.cmake`; CTest runs it on the
# source tree (tests/repo). Build trees and fetched third-party code are not searched.

if(NOT ROOT)
    message(FATAL_ERROR "usage: cmake -DROOT=<dir> -P check-spdx.cmake")
endif()

get_filename_component(ROOT "${ROOT}" ABSOLUTE)

set(spdx "SPDX-License-Identifier: AGPL-3.0-only")
set(cpp_patterns *.h *.hpp *.cpp *.cc *.cxx)
set(hash_patterns CMakeLists.txt *.cmake *.ps1 *.sh *.py *.yml *.yaml)
set(source_dirs src tests tools cmake .github examples)

# Patterns for one directory: the directory itself (top level only) or everything below it.
function(proton_spdx_globs out dir recurse)
    set(globs "")
    foreach(pattern IN LISTS cpp_patterns hash_patterns)
        list(APPEND globs "${dir}/${pattern}")
    endforeach()
    if(recurse)
        file(GLOB_RECURSE files LIST_DIRECTORIES false ${globs})
    else()
        file(GLOB files LIST_DIRECTORIES false ${globs})
    endif()
    set(${out} "${files}" PARENT_SCOPE)
endfunction()

proton_spdx_globs(files "${ROOT}" FALSE)
foreach(dir IN LISTS source_dirs)
    if(IS_DIRECTORY "${ROOT}/${dir}")
        proton_spdx_globs(dir_files "${ROOT}/${dir}" TRUE)
        list(APPEND files ${dir_files})
    endif()
endforeach()
list(SORT files)

set(missing "")
set(count 0)
foreach(file IN LISTS files)
    get_filename_component(ext "${file}" LAST_EXT)
    if(ext MATCHES "^\\.(h|hpp|cpp|cc|cxx)$")
        set(expected "// ${spdx}")
    else()
        set(expected "# ${spdx}")
    endif()
    string(LENGTH "${expected}" length)
    file(READ "${file}" head LIMIT 128)
    string(LENGTH "${head}" head_length)
    set(first "")
    set(next "")
    if(head_length GREATER length)
        string(SUBSTRING "${head}" 0 ${length} first)
        string(SUBSTRING "${head}" ${length} 1 next)
    endif()
    if(NOT first STREQUAL expected OR NOT next MATCHES "^[\r\n]$")
        file(RELATIVE_PATH relative "${ROOT}" "${file}")
        list(APPEND missing "${relative}")
    endif()
    math(EXPR count "${count} + 1")
endforeach()

if(missing)
    list(JOIN missing "\n  " text)
    message(FATAL_ERROR "files not starting with the SPDX line ('${spdx}'):\n  ${text}")
endif()
message(STATUS "${count} source files start with the SPDX line")
